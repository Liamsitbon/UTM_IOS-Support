@@ -0,0 +1,28 @@
+/* Native ES1 transfer staging; no OpenGL dependency. GPL-2.0-or-later. */
+#ifndef LTM_IOS_TRANSFER_H
+#define LTM_IOS_TRANSFER_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline void ltm_ios_pack_rows(uint8_t *data, size_t width, size_t height,
+                                     size_t bpp, size_t stride)
+{
+    size_t row = width * bpp;
+    for (size_t y = 1; y < height; y++) {
+        memmove(data + y * row, data + y * stride, row);
+    }
+}
+
+static inline void ltm_ios_reverse_words(uint8_t *data, size_t width,
+                                         size_t height, size_t stride)
+{
+    for (size_t y = 0; y < height; y++) {
+        for (size_t x = 0; x < width; x++) {
+            uint8_t *p = data + y * stride + x * 4;
+            uint8_t a = p[0], b = p[1];
+            p[0] = p[3]; p[1] = p[2]; p[2] = b; p[3] = a;
+        }
+    }
+}
+#endif
